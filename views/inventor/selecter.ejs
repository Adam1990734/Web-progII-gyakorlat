<div class="box" style="margin-top: 0.5em; margin-bottom: 0.5em;">
	<label for="searcher">Search and Link Inventions:</label>
	<input type="text" id="searcher" placeholder="Type invention name to search..." />
	<div id="suggestions" style="margin-top: 0.5em;"></div>

	<h4 style="margin-top: 1.5em; margin-bottom: 0.5em;">Selected Inventions</h4>
	<% if (isUpdate) { %>
		<script>
			let selectedInventions = <%- JSON.stringify(inventor.getInventions()) %>;
		</script>
	<% } else { %>
		<script>
			let selectedInventions = [];
		</script>
	<% } %>
	<div id="selected-inventions"></div>
</div>
<script src="/js/inventionSelector.js"></script>