<%- include("../partials/header") %>
    <h1>Inventions</h1>
    <a href="/crud/inventors/create">Create a new inventor!</a>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Born In</th>
                <th>Died In</th>
                <th>Operatios</th>
            </tr>
        </thead>
        <tbody>
            <% inventors.forEach(inventor => { %>
                <tr>
                    <td><%= inventor.getName() %></td>
                    <td><%= inventor.getBornAt() %></td>
                    <td><%= inventor.getDiedAt() %></td>
                    <td>
                        <a href="/crud/inventors/details/<%= inventor.getId() %>">Details</a>
                        <a href="/crud/inventors/update/<%= inventor.getId() %>">Edit</a>
                        <a href="/crud/inventors/delete/<%= inventor.getId() %>">Delete</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <%- include('../partials/pager') %>
<%- include("../partials/footer") %>