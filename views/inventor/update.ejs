<%- include("../partials/header") %>
    <form method="post" action="/inventors/update/<%= inventor.getId() %>">
        <div>
            <label>Name:</label>
            <input name="name" value="<%= inventor.getName() %>">
        </div>
        <div>
            <label>Born In:</label>
            <input name="bornAt" value="<%= inventor.getBornAt() %>">
        </div>
        <div>
            <label>Died In:</label>
            <input name="diedAt" value="<%= inventor.getDiedAt() %>">
        </div>
        <%- include('selecter') %>
        <button type="submit">Update</button>
    </form>
    <a href="/inventors">Back</a>
<%- include("../partials/footer") %>