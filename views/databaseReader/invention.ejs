<%- include("../partials/header") %>
    <h1>Inventions</h1>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Operatios</th>
            </tr>
        </thead>
        <tbody>
            <% inventions.forEach(invention => { %>
                <tr>
                    <td><%= invention.getName() %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <%- include('../partials/pager') %>
<%- include("../partials/footer") %>