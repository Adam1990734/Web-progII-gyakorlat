<%- include("../partials/header", { pageTitle: "Contact Us", pageSubtitle: "Send a message or suggestion to the site administrators" }) %>

<section>
	<h3>Send a Message</h3>
	<form method="post">
		<div class="row gtr-uniform">
			<div class="col-12">
				<% if (error) { %>
					<div class="message">
						<span><%= error %></span>
					</div>
				<% } %>
				<textarea name="content" id="content" placeholder="Enter your message here..." rows="6"></textarea>
			</div>
			<div class="col-12">
				<ul class="actions">
					<li><input type="submit" value="Send" class="primary" /></li>
					<li><input type="reset" value="Reset" /></li>
				</ul>
			</div>
		</div>
	</form>
</section>

<%- include("../partials/footer") %>