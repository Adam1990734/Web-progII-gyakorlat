<%- include("../partials/header") %>
<h1>
    Messsages
</h1>
<table>
    <thead>
        <tr>
            <th>Username</th>
            <th>Crated At</th>
            <th>Content</th>
        </tr>
    </thead>
    <tbody>
        <% messages.forEach(element => { %>
            <tr>
                <td><%= element.getUserName %></td>
                <td><%= element.getCreatedAt %></td>
                <td><%= element.getContent %></td>
            </tr>
        <% }) %>
    </tbody>
</table>
<% if (lastpage + 1 < (allcount / len)) { %>
    <form method="get">
        <input hidden type="text" name="page" value="<%= lastpage + 1 %>">
        <button type="submit">Next</button>
    </form>
<% } %>
<% if (lastpage > 0) { %>
    <form method="get">
        <input hidden type="text" name="page" value="<%= lastpage - 1 %>">
        <button type="submit">Prev</button>
    </form>
<% } %>
<%- include("../partials/footer") %>