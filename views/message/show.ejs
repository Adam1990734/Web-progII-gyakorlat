<%- include("../partials/header") %>
<h1>
    Messsages
</h1>
<table>
    <thead>
        <tr>
            <th>Username</th>
            <th>Crated At</th>
            <th>Content</th>
        </tr>
    </thead>
    <tbody>
        <% messages.forEach(element => { %>
            <tr>
                <td><%= element.getUserName %></td>
                <td><%= element.getCreatedAt %></td>
                <td><%= element.getContent %></td>
            </tr>
        <% }) %>
    </tbody>
</table>
<%- include('../partials/pager') %>
<%- include("../partials/footer") %>