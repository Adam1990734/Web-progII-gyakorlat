<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body>
        <nav>
            <div>
                <a href="/">Home</a>
            </div>
            <!-- Üzenet küldés -->
            <div>
                <a href="/contact">Contact</a>
            </div>
            <!-- Diagram menü -->
            <div>
                <a href="/diagrams/withcount">WithCount</a>
                <a href="/diagrams/timeline">Timeline</a>
            </div>
            <!-- Üzenetek -->
            <% if(user){ %>
                <div>
                    <a href="/messages">Messages</a>
                </div>
            <% } %>
            <!-- CRUD -->
            <% if(user && user.role=="ADMIN"){ %>
                <div>
                    <a href="/crud/inventions">Inventions</a>
                    <a href="/crud/inventors">Inventors</a>
                </div>
            <% } %>
            <% if(!user){ %>
                <div>
                    <a href="/login">Login</a>
                    <a href="/register">Register</a>
                </div>
            <% }else{ %>
                <div>
                    <span><%= user.username %></span>
                    <a href="/logout">Logout</a>
                </div>
            <% } %>
        </nav>
        <hr>