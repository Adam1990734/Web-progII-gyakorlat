<div id="pager">
    <% if (lastpage + 1 < (allcount / len)) { %>
        <form method="get">
            <input hidden type="text" name="page" value="<%= lastpage + 1 %>">
            <button type="submit">Next</button>
        </form>
    <% } %>
    <% if (lastpage > 0) { %>
        <form method="get">
            <input hidden type="text" name="page" value="<%= lastpage - 1 %>">
            <button type="submit">Prev</button>
        </form>
    <% } %>
</div>