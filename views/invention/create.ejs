<%- include("../partials/header", { pageTitle: "Create Invention", pageSubtitle: "Add a new invention to the archive" }) %>

<section>
	<h3>New Invention</h3>
	<form method="post">
		<div class="row gtr-uniform">
			<div class="col-12">
				<label for="name">Name:</label>
				<input type="text" name="name" id="name" placeholder="Invention name" required />
			</div>
			<div class="col-12">
				<ul class="actions">
					<li><input type="submit" value="Create" class="primary" /></li>
					<li><a href="/crud/inventions" class="button">Back</a></li>
				</ul>
			</div>
		</div>
	</form>
</section>

<%- include("../partials/footer") %>